{
	"schemaVersion": 1,
	"id": "better-menu-buttons",
	"version": "${version}",
	"name": "Better menu buttons",
	"description": "Lets you move or hide Minecraft's menu buttons.",
	"authors": [
		"JulianH06"
	],
	"license": "CC0-1.0",
	"icon": "assets/better-menu-buttons/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.julianh06.bettermenubuttons.BetterMenuButtonsClient"
		],
		"modmenu": [
			"com.julianh06.bettermenubuttons.config.BetterMenuButtonsModMenu"
		]
	},
	"mixins": [
		{
			"config": "better-menu-buttons.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
